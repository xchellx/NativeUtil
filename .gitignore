# Godot auto generated files
*.gen.*
.godot/

# Ignore library files but not the gdextension file
native_util/bin/*
!native_util/bin/android
native_util/bin/android/*
!native_util/bin/android/.gitkeep
!native_util/bin/linux
native_util/bin/linux/*
!native_util/bin/linux/.gitkeep
!native_util/bin/macos
native_util/bin/macos/*
!native_util/bin/macos/.gitkeep
!native_util/bin/windows
native_util/bin/windows/*
!native_util/bin/windows/.gitkeep
!native_util/bin/*.gdextension
.sconsign*.dblite

# Ignore custom.py
custom.py

# Ignore generated compile_commands.json
compile_commands.json

# Ignore files generated for documentation
/src/gen

# Binaries
*.o
*.os
*.so
*.obj
*.bc
*.pyc
*.dblite
*.pdb
*.lib
*.config
*.creator
*.creator.user
*.files
*.includes
*.idb
*.exp

# Other stuff
*.log

# VSCode
.vscode/*
!.vscode/extensions.json
.DS_Store

# Jetbrains
.idea/
